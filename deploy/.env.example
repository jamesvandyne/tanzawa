###############################################################################
# Required
###############################################################################

# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe())"
SECRET_KEY=

# Comma-separated. Always include the domain you'll reach Tanzawa from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Used to build absolute URLs (Open Graph tags, feed entry URLs, IndieWeb endpoints).
# Match this to the public hostname your readers use.
DOMAIN_NAME=localhost
PROTOCOL=http

###############################################################################
# Persistent storage (paths INSIDE the container; do not change unless you also
# change docker-compose.yml volume mounts).
###############################################################################

DB_NAME=/data/db.sqlite3
MEDIA_ROOT=/data/media/

###############################################################################
# Production hardening — enable when serving over HTTPS.
###############################################################################

DEBUG=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

###############################################################################
# Localization
###############################################################################

LANGUAGE_CODE=en-us
TIME_ZONE=UTC

###############################################################################
# Host ports — only used by docker-compose, not by Django itself.
###############################################################################

# Bind Caddy's :80 to this host port (default 8080 to avoid privileged-port hassle).
# For production set HTTP_PORT=80 and HTTPS_PORT=443.
HTTP_PORT=8080
HTTPS_PORT=8443

###############################################################################
# Initial superuser (optional, first-boot only)
#
# If both USERNAME and PASSWORD are set, the bootstrap script creates this
# superuser on the FIRST container boot. On subsequent boots it's a no-op
# (idempotent — checked by username). To change credentials later, use:
#   docker compose exec app python apps/manage.py changepassword <username>
# Leave blank to create the superuser manually:
#   docker compose exec app python apps/manage.py createsuperuser
###############################################################################

TANZAWA_SUPERUSER_USERNAME=
TANZAWA_SUPERUSER_EMAIL=
TANZAWA_SUPERUSER_PASSWORD=

###############################################################################
# Optional
###############################################################################

# Force-enable specific plugins at boot (bypasses the DB toggle).
# FORCE_ENABLED_PLUGINS=blog.tanzawa.plugins.health,blog.tanzawa.plugins.exercise

# Featured stream on the homepage.
# HIGHLIGHT_STREAM_SLUG=the-week

# Sentry error tracking.
# ENABLE_SENTRY=True
# SENTRY_DSN=

# Strava integration (exercise plugin).
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=

# Sunbottle integration (solar generation).
# SUNBOTTLE_API_URL=
