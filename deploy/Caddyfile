# Tanzawa reverse proxy.
#
# The site label below is read from the CADDY_SITE_ADDRESS env var passed in
# by docker-compose.yml (which reads it from .env).
#
#   Local development:   CADDY_SITE_ADDRESS=:80
#                        → site reachable at http://localhost:${HTTP_PORT}
#
#   Production HTTPS:    CADDY_SITE_ADDRESS=blog.example.com
#                        → Caddy automatically obtains a Let's Encrypt cert
#                          (ACME HTTP-01 challenge on port 80, requires DNS
#                          A record pointing to this server + ports 80 and
#                          443 reachable from the public internet).
#                        → HTTP traffic is auto-redirected to HTTPS.
#
# To receive Let's Encrypt renewal notifications, uncomment the global block
# below and put your email in it. (We can't make this env-driven because
# Caddyfile syntax has no way to omit the `email` directive when the var is
# empty — empty `email ` is a parse error.)
#
#     {
#         email you@example.com
#     }

{$CADDY_SITE_ADDRESS::80} {
	# Sensible defaults — adjust per deployment.
	encode gzip zstd

	# Static assets — served directly from the shared volume (no Django round-trip).
	handle_path /static/* {
		root * /srv/static
		file_server
	}

	# User-uploaded media (Micropub uploads, post images).
	handle_path /media/* {
		root * /srv/data/media
		file_server
	}

	# Everything else proxies to Django/uWSGI. Caddy automatically sets
	# X-Forwarded-For, X-Forwarded-Proto, X-Forwarded-Host, and preserves
	# the original Host header by default — no explicit header_up needed.
	reverse_proxy app:8000

	# Cap upload size at 25 MB — matches the typical Micropub media limit.
	# Raise if you publish large image/video posts.
	request_body {
		max_size 25MB
	}
}
